# Copy to .env in the same directory as docker-compose.prod.yml, then fill in real values.
# `docker compose` loads .env automatically for ${VAR} substitution in the compose file.
# Never commit the real .env — it already matches the .env ignore rule in .gitignore.

# --- Postgres ---
POSTGRES_USER=clearspeech
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=clearspeech

# --- Backend (FastAPI) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value
GEMINI_API_KEY=your-gemini-api-key
# Comma-separated list of allowed frontend origins, e.g. https://app.example.com
# Use "*" only for a quick test deploy — never in real production.
CORS_ORIGINS=https://app.example.com

# --- Frontend (Vite, baked in at build time) ---
# Public URL the browser will call directly for every API request.
VITE_API_URL=https://api.example.com
